<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ category.name }} - Our Store</title>
    <meta name="description" content="Découvrez les produits de la catégorie {{ category.name }} dans notre boutique.">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8f9fa; }

        .navbar { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%) !important; box-shadow: 0 2px 20px rgba(0,0,0,0.3); }
        .navbar-brand { font-weight: 800; font-size: 1.4rem; color: #fff !important; }
        .nav-link { font-weight: 500; transition: color .2s; }
        .nav-link:hover { color: #6c63ff !important; }

        /* Jumbotron catégorie */
        .category-hero {
            background: linear-gradient(135deg, #6c63ff 0%, #3f3d56 70%, #1a1a2e 100%);
            border-radius: 20px;
            position: relative; overflow: hidden;
        }
        .category-hero::before {
            content: '';
            position: absolute; inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffffff' fill-opacity='0.05'%3E%3Ccircle cx='20' cy='20' r='15'/%3E%3C/g%3E%3C/svg%3E");
        }
        .category-hero-icon { font-size: 4rem; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.3)); }

        /* Product cards */
        .product-card {
            border: none; border-radius: 14px;
            transition: transform .25s ease, box-shadow .25s ease;
            overflow: hidden; background: #fff;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        }
        .product-card:hover { transform: translateY(-5px); box-shadow: 0 14px 36px rgba(0,0,0,0.13); }
        .product-card .card-img-top {
            height: 200px; object-fit: cover;
            background: linear-gradient(135deg, #ede9fe, #e0e7ff);
        }
        .product-img-placeholder {
            height: 200px; display: flex; align-items: center; justify-content: center;
            background: linear-gradient(135deg, #ede9fe, #e0e7ff);
            font-size: 3.5rem;
        }
        .price-tag { font-size: 1.2rem; font-weight: 700; color: #16a34a; }
        .btn-detail { border-radius: 8px; font-weight: 600; font-size: .88rem; padding: 8px 18px; transition: all .2s; }
        .stock-badge { font-size: .75rem; font-weight: 600; padding: 3px 10px; border-radius: 50px; }

        /* Breadcrumb */
        .breadcrumb { background: transparent; padding: 0; }
        .breadcrumb-item a { color: #6c63ff; text-decoration: none; }

        /* Empty state */
        .empty-state { padding: 60px 20px; text-align: center; }
        .empty-state-icon { font-size: 4rem; margin-bottom: 16px; }

        footer { background: linear-gradient(135deg, #1a1a2e, #16213e); }
    </style>
</head>
<body>
    <!-- Header -->
    {% include '_navbar.html.twig' %}

    <!-- Breadcrumb -->
    <div class="container mt-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_index') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_browse_categories') }}">Catégories</a></li>
                <li class="breadcrumb-item active" aria-current="page">{{ category.name }}</li>
            </ol>
        </nav>
    </div>

    <!-- Category Hero -->
    <div class="container my-4">
        <div class="category-hero p-5 text-white position-relative">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <span class="category-hero-icon">{{ category.icon ?? '🏷️' }}</span>
                        <div>
                            <h1 class="display-5 fw-bold mb-1">{{ category.name }}</h1>
                            <p class="mb-0 opacity-80 fs-5">
                                {{ category.description ?? 'Découvrez nos produits dans cette catégorie.' }}
                            </p>
                        </div>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="badge bg-light text-dark fs-6 px-3 py-2">
                        {{ products|length }} produit{{ products|length > 1 ? 's' : '' }}
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Grid -->
    <div class="container mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold mb-0">Produits — {{ category.name }}</h3>
            <a href="{{ path('app_browse_categories') }}" class="btn btn-outline-secondary btn-sm">
                ← Toutes les catégories
            </a>
        </div>

        {% if products is empty %}
            <div class="empty-state">
                <div class="empty-state-icon">📭</div>
                <h4 class="fw-bold text-muted">Aucun produit dans cette catégorie</h4>
                <p class="text-muted">Revenez bientôt, des produits seront ajoutés prochainement.</p>
                <a href="{{ path('app_browse_categories') }}" class="btn btn-primary mt-2">Voir les autres catégories</a>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
                {% for product in products %}
                    <div class="col">
                        <div class="card product-card h-100">
                            {% if product.imageUrl %}
                                <img src="{{ product.imageUrl }}" class="card-img-top" alt="{{ product.name }}">
                            {% else %}
                                <div class="product-img-placeholder">
                                    {{ category.icon ?? '📦' }}
                                </div>
                            {% endif %}
                            <div class="card-body d-flex flex-column">
                                <span class="badge bg-primary bg-opacity-10 text-primary mb-2 align-self-start">
                                    {{ category.name }}
                                </span>
                                <h5 class="card-title fw-bold mb-1">{{ product.name }}</h5>
                                <div class="d-flex align-items-center justify-content-between mt-auto pt-3">
                                    <span class="price-tag">{{ product.price|number_format(2, '.', ' ') }} €</span>
                                    {% if product.isInStock() %}
                                        <span class="stock-badge bg-success bg-opacity-10 text-success">En stock</span>
                                    {% else %}
                                        <span class="stock-badge bg-danger bg-opacity-10 text-danger">Rupture</span>
                                    {% endif %}
                                </div>
                                <a href="{{ path('app_product_details', {id: product.id}) }}"
                                   class="btn btn-primary btn-detail w-100 mt-3">
                                    Voir le détail →
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <!-- Footer -->
    <footer class="text-white py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="fw-bold mb-1">🛍️ Our Store</h5>
                    <p class="text-white-50 small mb-0">Des produits de qualité à prix abordables.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-white-50 small mb-0">&copy; {{ "now"|date("Y") }} Our Store. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>