<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parcourir les catégories - Our Store</title>
    <meta name="description" content="Explorez toutes nos catégories de produits et trouvez ce qu'il vous faut.">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8f9fa; }

        /* Navbar */
        .navbar { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%) !important; box-shadow: 0 2px 20px rgba(0,0,0,0.3); }
        .navbar-brand { font-weight: 800; font-size: 1.4rem; color: #fff !important; letter-spacing: -0.5px; }
        .nav-link { font-weight: 500; transition: color .2s; }
        .nav-link:hover { color: #6c63ff !important; }

        /* Hero */
        .hero-section {
            background: linear-gradient(135deg, #6c63ff 0%, #3f3d56 60%, #1a1a2e 100%);
            padding: 80px 0 60px;
            position: relative;
            overflow: hidden;
        }
        .hero-section::before {
            content: '';
            position: absolute; inset: 0;
            background: url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.04'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");
        }
        .hero-section h1 { font-weight: 800; font-size: 2.8rem; }
        .hero-badge { background: rgba(255,255,255,0.15); backdrop-filter: blur(10px); border: 1px solid rgba(255,255,255,0.25); padding: 6px 16px; border-radius: 50px; display: inline-block; font-size: .85rem; }

        /* Category cards */
        .category-card {
            border: none;
            border-radius: 16px;
            transition: transform .25s ease, box-shadow .25s ease;
            overflow: hidden;
            background: #fff;
            box-shadow: 0 2px 12px rgba(0,0,0,0.07);
        }
        .category-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.13);
        }
        .category-icon-wrap {
            width: 72px; height: 72px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 16px;
            font-size: 2rem;
            background: linear-gradient(135deg, #ede9fe, #c7d2fe);
        }
        .category-card .card-body { padding: 2rem 1.5rem; }
        .product-count-badge {
            font-size: .78rem; font-weight: 600;
            padding: 4px 12px; border-radius: 50px;
            letter-spacing: .3px;
        }
        .btn-browse {
            border-radius: 8px; font-weight: 600;
            padding: 8px 20px; font-size: .9rem;
            transition: all .2s;
        }

        /* Features */
        .features-section { background: linear-gradient(180deg, #fff 0%, #f0f4ff 100%); }
        .feature-icon { width: 60px; height: 60px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }

        /* Footer */
        footer { background: linear-gradient(135deg, #1a1a2e, #16213e); }

        /* Empty state */
        .empty-state { padding: 60px 20px; text-align: center; }
        .empty-state-icon { font-size: 4rem; margin-bottom: 16px; }
    </style>
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_index') }}">🛍️ Our Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_index') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="{{ path('app_browse_categories') }}">Catégories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_cart') }}">🛒 Panier</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_profile') }}">Profil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="hero-section text-white">
        <div class="container position-relative">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <p class="hero-badge mb-3">🏪 Notre boutique</p>
                    <h1 class="display-4 fw-bold mb-3">Parcourir les catégories</h1>
                    <p class="lead mb-4 opacity-90">Explorez notre sélection de produits organisés par catégorie. Qualité et variété garanties.</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a href="{{ path('app_index') }}" class="btn btn-light btn-lg fw-semibold">🛍️ Voir tous les produits</a>
                        <a href="#categories" class="btn btn-outline-light btn-lg">Explorer ↓</a>
                    </div>
                </div>
                <div class="col-lg-5 text-center d-none d-lg-block">
                    <div style="font-size: 8rem; line-height:1; filter: drop-shadow(0 10px 30px rgba(0,0,0,0.3));">🛒</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Categories Section -->
    <div class="container my-5" id="categories">
        <div class="text-center mb-5">
            <h2 class="fw-bold fs-1 mb-2">Nos catégories</h2>
            <p class="text-muted fs-5">
                {% set totalProducts = 0 %}
                {% for row in categoriesData %}
                    {% set totalProducts = totalProducts + row.productCount %}
                {% endfor %}
                {{ categoriesData|length }} catégorie{{ categoriesData|length > 1 ? 's' : '' }} · {{ totalProducts }} produit{{ totalProducts > 1 ? 's' : '' }} disponible{{ totalProducts > 1 ? 's' : '' }}
            </p>
        </div>

        {% if categoriesData is empty %}
            <div class="empty-state">
                <div class="empty-state-icon">📦</div>
                <h4 class="fw-bold text-muted">Aucune catégorie disponible</h4>
                <p class="text-muted">Revenez bientôt, des catégories seront ajoutées prochainement.</p>
            </div>
        {% else %}
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                {% for row in categoriesData %}
                    {% set category = row[0] %}
                    {% set count    = row.productCount %}
                    <div class="col">
                        <div class="card category-card h-100">
                            <div class="card-body text-center">
                                <div class="category-icon-wrap mb-3">
                                    {{ category.icon ?? '🏷️' }}
                                </div>
                                <span class="badge product-count-badge bg-{{ category.badgeColor ?? 'primary' }} bg-opacity-10 text-{{ category.badgeColor ?? 'primary' }} mb-2">
                                    {{ count }} produit{{ count > 1 ? 's' : '' }}
                                </span>
                                <h4 class="card-title fw-bold mt-2 mb-2">{{ category.name }}</h4>
                                <p class="card-text text-muted small mb-4">
                                    {{ category.description ?? 'Découvrez nos produits dans cette catégorie.' }}
                                </p>
                                <a href="{{ path('app_products_by_category', {id: category.id}) }}"
                                   class="btn btn-{{ category.badgeColor ?? 'primary' }} btn-browse w-100">
                                    Voir les produits →
                                </a>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>

    <!-- Features Section -->
    <div class="features-section py-5 mt-3">
        <div class="container">
            <div class="row text-center g-4">
                <div class="col-md-4">
                    <div class="feature-icon bg-primary bg-opacity-10 mx-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#6c63ff" viewBox="0 0 16 16">
                            <path d="M0 3.5A1.5 1.5 0 0 1 1.5 2h9A1.5 1.5 0 0 1 12 3.5V5h1.02a1.5 1.5 0 0 1 1.17.563l1.481 1.85a1.5 1.5 0 0 1 .329.938V10.5a1.5 1.5 0 0 1-1.5 1.5H14a2 2 0 1 1-4 0H5a2 2 0 1 1-3.998-.085A1.5 1.5 0 0 1 0 10.5zm1.294 7.456A2 2 0 0 1 4.732 11h5.536a2 2 0 0 1 .732-.732V3.5a.5.5 0 0 0-.5-.5h-9a.5.5 0 0 0-.5.5v7a.5.5 0 0 0 .294.456M12 10a2 2 0 0 1 1.732 1h.768a.5.5 0 0 0 .5-.5V8.35a.5.5 0 0 0-.11-.312l-1.48-1.85A.5.5 0 0 0 13.02 6H12zm-9 1a1 1 0 1 0 0 2 1 1 0 0 0 0-2m9 0a1 1 0 1 0 0 2 1 1 0 0 0 0-2"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">Livraison gratuite</h5>
                    <p class="text-muted small">Dès 50€ d'achat</p>
                </div>
                <div class="col-md-4">
                    <div class="feature-icon bg-success bg-opacity-10 mx-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#198754" viewBox="0 0 16 16">
                            <path d="M5.338 1.59a61 61 0 0 0-2.837.856.48.48 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.7 10.7 0 0 0 2.287 2.233c.346.244.652.42.893.533q.18.085.293.118a1 1 0 0 0 .101.025 1 1 0 0 0 .1-.025q.114-.034.294-.118c.24-.113.547-.29.893-.533a10.7 10.7 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                            <path d="M10.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 1 1 .708-.708L7.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">Paiement sécurisé</h5>
                    <p class="text-muted small">Transactions 100% sécurisées</p>
                </div>
                <div class="col-md-4">
                    <div class="feature-icon bg-warning bg-opacity-10 mx-auto">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="#ffc107" viewBox="0 0 16 16">
                            <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2z"/>
                            <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466"/>
                        </svg>
                    </div>
                    <h5 class="fw-bold">Retours faciles</h5>
                    <p class="text-muted small">30 jours pour changer d'avis</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-white mt-0 py-4">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="fw-bold mb-1">🛍️ Our Store</h5>
                    <p class="text-white-50 small mb-0">Des produits de qualité à prix abordables.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-white-50 small mb-0">&copy; {{ "now"|date("Y") }} Our Store. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>