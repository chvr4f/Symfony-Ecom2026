<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ product.name }} - Our Store</title>
    <meta name="description" content="{{ product.description|slice(0, 155)|default('Détails du produit ' ~ product.name) }}">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #f8f9fa; }

        .navbar { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%) !important; box-shadow: 0 2px 20px rgba(0,0,0,0.3); }
        .navbar-brand { font-weight: 800; font-size: 1.4rem; color: #fff !important; }
        .nav-link { font-weight: 500; transition: color .2s; }
        .nav-link:hover { color: #6c63ff !important; }

        /* Product section */
        .product-section { background: #fff; border-radius: 20px; box-shadow: 0 4px 24px rgba(0,0,0,0.08); overflow: hidden; }
        .product-image-wrap {
            background: linear-gradient(135deg, #ede9fe 0%, #e0e7ff 100%);
            min-height: 380px; display: flex; align-items: center; justify-content: center;
            position: relative; overflow: hidden;
        }
        .product-image-wrap img {
            max-height: 380px; width: 100%; object-fit: contain;
            transition: transform .4s ease;
        }
        .product-image-wrap:hover img { transform: scale(1.04); }
        .product-img-placeholder-icon { font-size: 7rem; opacity: .6; }

        .product-info { padding: 2.5rem; }
        .price-display { font-size: 2.2rem; font-weight: 800; color: #16a34a; }
        .stock-indicator { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: .9rem; }
        .stock-dot { width: 10px; height: 10px; border-radius: 50%; }

        .qty-input { max-width: 110px; border-radius: 10px; font-weight: 600; text-align: center; border: 2px solid #e5e7eb; }
        .qty-input:focus { border-color: #6c63ff; box-shadow: 0 0 0 3px rgba(108,99,255,0.15); }

        .btn-add-cart {
            background: linear-gradient(135deg, #6c63ff, #4f46e5);
            border: none; border-radius: 12px; font-weight: 700;
            font-size: 1.05rem; padding: 12px 28px;
            transition: all .25s; color: #fff;
        }
        .btn-add-cart:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(108,99,255,0.35); color: #fff; }
        .btn-continue { border-radius: 12px; font-weight: 600; padding: 12px 24px; border-width: 2px; }

        .meta-list li { padding: 10px 0; border-bottom: 1px solid #f0f0f0; font-size: .95rem; }
        .meta-list li:last-child { border-bottom: none; }

        .breadcrumb { background: transparent; padding: 0; }
        .breadcrumb-item a { color: #6c63ff; text-decoration: none; }

        footer { background: linear-gradient(135deg, #1a1a2e, #16213e); }
    </style>
</head>
<body>
    <!-- Header -->
    <nav class="navbar navbar-expand-lg navbar-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_index') }}">🛍️ Our Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_index') }}">Accueil</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_browse_categories') }}">Catégories</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_cart') }}">🛒 Panier</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_profile') }}">Profil</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-5">
        <!-- Breadcrumb -->
        <nav aria-label="breadcrumb" class="mb-4">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="{{ path('app_index') }}">Accueil</a></li>
                <li class="breadcrumb-item"><a href="{{ path('app_browse_categories') }}">Catégories</a></li>
                {% if product.category %}
                    <li class="breadcrumb-item">
                        <a href="{{ path('app_products_by_category', {id: product.category.id}) }}">
                            {{ product.category.name }}
                        </a>
                    </li>
                {% endif %}
                <li class="breadcrumb-item active" aria-current="page">{{ product.name }}</li>
            </ol>
        </nav>

        <!-- Product Card -->
        <div class="product-section">
            <div class="row g-0">
                <!-- Image -->
                <div class="col-md-5">
                    <div class="product-image-wrap h-100">
                        {% if product.imageUrl %}
                            <img src="{{ product.imageUrl }}" alt="{{ product.name }}">
                        {% else %}
                            <div class="text-center">
                                <div class="product-img-placeholder-icon">
                                    {{ product.category ? product.category.icon : '📦' }}
                                </div>
                                <p class="text-muted small mt-2">Image non disponible</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- Info -->
                <div class="col-md-7">
                    <div class="product-info">
                        {% if product.category %}
                            <a href="{{ path('app_products_by_category', {id: product.category.id}) }}"
                               class="badge bg-primary bg-opacity-10 text-primary text-decoration-none mb-3 fs-6 px-3 py-2">
                                {{ product.category.icon ?? '' }} {{ product.category.name }}
                            </a>
                        {% endif %}

                        <h1 class="fw-bold mb-2 fs-2">{{ product.name }}</h1>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <span class="price-display">{{ product.price|number_format(2, '.', ' ') }} €</span>
                            {% if product.isInStock() %}
                                <span class="stock-indicator text-success">
                                    <span class="stock-dot bg-success"></span>
                                    En stock ({{ product.stock }} unités)
                                </span>
                            {% else %}
                                <span class="stock-indicator text-danger">
                                    <span class="stock-dot bg-danger"></span>
                                    Rupture de stock
                                </span>
                            {% endif %}
                        </div>

                        {% if product.description %}
                            <div class="mb-4">
                                <h5 class="fw-bold mb-2">Description</h5>
                                <p class="text-muted lh-lg">{{ product.description }}</p>
                            </div>
                        {% endif %}

                        <!-- Add to Cart -->
                        <form method="post" action="{{ path('cart_add', {id: product.id}) }}">
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div>
                                    <label for="quantity" class="form-label fw-semibold small text-muted">Quantité</label>
                                    <input type="number" class="form-control qty-input" id="quantity"
                                           name="quantity" value="1" min="1"
                                           max="{{ product.stock > 0 ? product.stock : 1 }}"
                                           {{ not product.isInStock() ? 'disabled' : '' }}>
                                </div>
                            </div>
                            <div class="d-flex gap-3 flex-wrap">
                                <button type="submit" class="btn btn-add-cart btn-lg"
                                        {{ not product.isInStock() ? 'disabled' : '' }}>
                                    🛒 Ajouter au panier
                                </button>
                                {% if product.category %}
                                    <a href="{{ path('app_products_by_category', {id: product.category.id}) }}"
                                       class="btn btn-outline-secondary btn-continue btn-lg">
                                        ← Continuer
                                    </a>
                                {% else %}
                                    <a href="{{ path('app_browse_categories') }}"
                                       class="btn btn-outline-secondary btn-continue btn-lg">
                                        ← Continuer
                                    </a>
                                {% endif %}
                            </div>
                        </form>

                        <!-- Meta info -->
                        <div class="mt-4 pt-3 border-top">
                            <ul class="list-unstyled meta-list mb-0">
                                {% if product.sku %}
                                    <li><strong>Référence (SKU) :</strong> <span class="text-muted">{{ product.sku }}</span></li>
                                {% endif %}
                                <li>
                                    <strong>Disponibilité :</strong>
                                    {% if product.isInStock() %}
                                        <span class="text-success fw-semibold">✓ En stock</span>
                                    {% else %}
                                        <span class="text-danger fw-semibold">✗ Rupture de stock</span>
                                    {% endif %}
                                </li>
                                {% if product.category %}
                                    <li>
                                        <strong>Catégorie :</strong>
                                        <a href="{{ path('app_products_by_category', {id: product.category.id}) }}"
                                           class="text-primary text-decoration-none">
                                            {{ product.category.name }}
                                        </a>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="text-white py-4 mt-5">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h5 class="fw-bold mb-1">🛍️ Our Store</h5>
                    <p class="text-white-50 small mb-0">Des produits de qualité à prix abordables.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="text-white-50 small mb-0">&copy; {{ "now"|date("Y") }} Our Store. Tous droits réservés.</p>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>